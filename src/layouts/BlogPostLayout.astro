---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Comments from "../components/Comments.astro";
import TagBadge from "../components/TagBadge.astro";

export interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, date, updated, tags, summary, lang, math } = post.data;
const formattedDate = date.toLocaleDateString(
  lang === "zh-CN" ? "zh-CN" : "en-US",
  { year: "numeric", month: "long", day: "numeric" }
);
const displayTitle = title + " - AI + Bio";

const headings = post.rendered
  ? (() => {
      const matches = post.rendered.html?.match(
        /<h([2-4])\s+id="([^"]*)">([^<]*)</g
      );
      return (
        matches?.map((m) => {
          const levelMatch = m.match(/<h([2-4])/);
          const idMatch = m.match(/id="([^"]*)"/);
          const textMatch = m.match(/>([^<]*)</);
          return {
            depth: parseInt(levelMatch?.[1] ?? "2"),
            slug: idMatch?.[1] ?? "",
            text: textMatch?.[1] ?? "",
          };
        }) ?? []
      );
    })()
  : [];
---

<BaseLayout title={displayTitle} description={summary}>
  <article class="mx-auto">
    <!-- Article Header -->
    <header class="mb-8 border-b border-gray-200 pb-8 dark:border-gray-800">
      <h1
        class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl"
      >
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {
          updated && (
            <>
              <span>·</span>
              <span class="italic">Updated: {updated.toLocaleDateString()}</span>
            </>
          )
        }
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => <TagBadge tag={tag} />)}
      </div>
    </header>

    <!-- Article Content with TOC -->
    <div class="lg:grid lg:grid-cols-[1fr_200px] lg:gap-8">
      <div
        class="prose prose-gray max-w-none dark:prose-invert lg:prose-lg"
        data-pagefind-body
      >
        <slot />
      </div>
      <aside class="hidden lg:block">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <!-- Post Navigation -->
    <footer class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-800">
      <Comments />
    </footer>
  </article>
</BaseLayout>

<script>
  // Copy button for code blocks
  document.querySelectorAll("pre").forEach((pre) => {
    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.textContent ?? "";
      await navigator.clipboard.writeText(code);
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = "Copy"), 2000);
    });
    pre.style.position = "relative";
    pre.appendChild(btn);
  });
</script>
