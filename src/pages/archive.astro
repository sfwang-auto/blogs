---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.DEV ? true : !data.draft;
});

const posts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Merge translation pairs by base slug
//   hello-world.md + hello-world.en.md → single entry with both lang links
interface MergedPost {
  zh: (typeof posts)[0] | undefined;
  en: (typeof posts)[0] | undefined;
  date: Date;
}
const merged = new Map<string, MergedPost>();
posts.forEach((post) => {
  const baseId = post.id.replace(/\.en\.md$/, ".md");
  if (!merged.has(baseId)) {
    merged.set(baseId, { zh: undefined, en: undefined, date: post.data.date });
  }
  const entry = merged.get(baseId)!;
  if (post.data.lang === "zh-CN") entry.zh = post;
  else entry.en = post;
  // Keep earliest date
  if (post.data.date < entry.date) entry.date = post.data.date;
});

const mergedList = [...merged.values()].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

// Group merged posts by year
const byYear = new Map<number, MergedPost[]>();
mergedList.forEach((mp) => {
  const year = mp.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(mp);
});

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="Archive - AI + Bio" description="Browse all articles by date">
  <div class="mx-auto max-w-3xl">
    <h1
      class="mb-8 text-3xl font-bold text-gray-900"
      data-zh="归档"
      data-en="Archive"
    >
      归档
    </h1>

    {
      years.length === 0 ? (
        <p
          class="text-gray-500"
          data-zh="暂无文章。"
          data-en="No posts yet."
        >
          暂无文章。
        </p>
      ) : (
        years.map(([year, yearPosts]) => (
          <section class="mb-8">
            <h2
              class="mb-4 text-2xl font-semibold text-gray-900"
            >
              {year}
            </h2>
            <ul class="space-y-3">
              {yearPosts.map((mp) => {
                const primary = mp.zh || mp.en;
                if (!primary) return null;
                return (
                  <li class="flex items-baseline gap-4">
                    <span class="shrink-0 text-sm text-gray-400 tabular-nums">
                      {mp.date.toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </span>
                    <a
                      href={`/blogs/posts/${primary.id.replace(/\.md$/, "")}`}
                      class="text-gray-700 no-underline transition hover:text-accent"
                    >
                      {primary.data.title}
                    </a>
                    {mp.zh && mp.en && (
                      <span class="flex gap-1 text-xs text-gray-400">
                        <a
                          href={`/blogs/posts/${mp.zh.id.replace(/\.md$/, "")}`}
                          class="hover:text-accent"
                        >中文</a>
                        <span>·</span>
                        <a
                          href={`/blogs/posts/${mp.en.id.replace(/\.md$/, "")}`}
                          class="hover:text-accent"
                        >EN</a>
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>