---
import TagBadge from "./TagBadge.astro";
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
const { title, date, tags, summary, lang } = post.data;

const formattedDate = date.toLocaleDateString(
  lang === "zh-CN" ? "zh-CN" : "en-US",
  { year: "numeric", month: "long", day: "numeric" }
);
---

<article class="group border-b border-gray-100 py-8 last:border-0 dark:border-gray-800">
  <a href={`/blogs/posts/${post.id.replace(/\.md$/, "")}`} class="no-underline">
    <h2 class="mb-2 text-xl font-semibold text-gray-900 transition group-hover:text-accent dark:text-gray-100">
      {title}
    </h2>
  </a>
  <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    <span>·</span>
    {tags.slice(0, 3).map((tag) => <TagBadge tag={tag} />)}
    {tags.length > 3 && <span class="text-xs">+{tags.length - 3} more</span>}
  </div>
  {summary && (
    <p class="text-gray-600 leading-relaxed dark:text-gray-300">{summary}</p>
  )}
</article>
