<h3
  class="mb-4 text-lg font-semibold text-gray-900"
  data-zh="评论"
  data-en="Comments"
>
  评论
</h3>
<div class="giscus"></div>

<script is:inline>
  function getLang() {
    // Follow global site language
    return localStorage.getItem("site-lang") || "zh-CN";
  }

  function loadGiscus(lang) {
    const container = document.querySelector(".giscus");
    if (!container) return;
    container.innerHTML = "";

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", "sfwang-auto/blogs");
    script.setAttribute("data-repo-id", "R_kgDOTyDvFw");
    script.setAttribute("data-category", "Comments");
    script.setAttribute("data-category-id", "DIC_kwDOTyDvF84DC8Bm");
    script.setAttribute("data-mapping", "pathname");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "1");
    script.setAttribute("data-input-position", "bottom");
    script.setAttribute("data-theme", "light");
    script.setAttribute("data-lang", lang);
    script.setAttribute("crossorigin", "anonymous");
    script.async = true;
    container.appendChild(script);
  }

  function sendGiscus(config) {
    const frame = document.querySelector("iframe.giscus-frame");
    if (frame) {
      frame.contentWindow?.postMessage(
        { giscus: { setConfig: config } },
        "https://giscus.app"
      );
    }
  }

  // ── Lazy load ─────────────────────────────────────
  let loaded = false;
  const giscusEl = document.querySelector(".giscus");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !loaded) {
          loadGiscus(getLang());
          loaded = true;
          observer.disconnect();
        }
      });
    },
    { rootMargin: "200px" }
  );
  if (giscusEl) observer.observe(giscusEl);

  // ── Follow global language changes ────────────────
  window.addEventListener("langchange", (e) => {
    const newLang = e.detail.lang;
    sendGiscus({ lang: newLang });
  });
</script>