---
import type { MarkdownHeading } from "astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings } = Astro.props as { headings: Heading[] };

if (headings.length === 0) return null;
---

<nav class="sticky top-20">
  <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
    Contents
  </h4>
  <ul class="space-y-2 text-sm leading-tight">
    {headings.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class={`block text-gray-500 no-underline transition hover:text-accent dark:text-gray-400 dark:hover:text-accent ${
            heading.depth === 3 ? "pl-3" : heading.depth === 4 ? "pl-6" : ""
          }`}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
