---
const { tag } = Astro.props;
---

<a
  href={`/blogs/tags/${tag}`}
  class="inline-block rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 no-underline transition hover:bg-gray-200 hover:text-gray-900 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-200"
>
  {tag}
</a>
